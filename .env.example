NORDVPN_USER=
NORDVPN_PASS=
NORDVPN_SERVER_COUNTRIES=
TZ=UTC

# Optional Jackett integration; leave both blank to disable.
JACKETT_URL=
JACKETT_API_KEY=
# Optional comma-separated indexer IDs; blank searches configured indexers.
JACKETT_INDEXERS=
# Increase for slow indexers, e.g. 45. Individual Jackett calls time out after 30s.
MAX_REQUEST_WAIT_SECONDS=15
